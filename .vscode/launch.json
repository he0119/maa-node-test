{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "运行 Maa 节点测试插件",
            "type": "extensionHost",
            "request": "launch",
            "args": [
                "--extensionDevelopmentPath=${workspaceFolder}",
                "${workspaceFolder}/../MaaEnd"
            ],
            "outFiles": [
                "${workspaceFolder}/out/**/*.js"
            ],
            "preLaunchTask": "compile"
        }
    ]
}
