{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build",
            "type": "shell",
            "command": "pnpm run build",
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": "$tsc"
        },
        {
            "label": "watch:tsc",
            "type": "shell",
            "command": "pnpm run watch",
            "isBackground": true,
            "problemMatcher": "$tsc-watch"
        },
        {
            "label": "watch:bundle",
            "type": "shell",
            "command": "pnpm run watch:bundle",
            "isBackground": true,
            "problemMatcher": []
        },
        {
            "label": "watch",
            "dependsOn": [
                "watch:tsc",
                "watch:bundle"
            ],
            "dependsOrder": "parallel",
            "group": "build",
            "problemMatcher": []
        }
    ]
}
